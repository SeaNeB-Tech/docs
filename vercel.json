{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": null,
  "headers": [
    {
      "source": "/hi/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/gu/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/hi", "destination": "/hi/index.html" },
    { "source": "/hi/((?!.*\\.).*)", "destination": "/hi/$1/index.html" },
    { "source": "/gu", "destination": "/gu/index.html" },
    { "source": "/gu/((?!.*\\.).*)", "destination": "/gu/$1/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/$1/index.html" }
  ]
}
